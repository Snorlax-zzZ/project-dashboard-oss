{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "project-dashboard",
  "version": "0.2.14",
  "identifier": "io.github.snorlaxzzz.projectdashboard",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "project-dashboard",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "本机+跨机开发看板",
    "longDescription": "project-dashboard：本机 cc 会话浏览 + 跨机项目状态看板（Rust 全栈，Tauri 桌面 App）"
  }
}
